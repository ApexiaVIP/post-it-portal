{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 2,10,11,16,17,19,20 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "30 11,12,14,15 * * 1-5"
    },
    {
      "path": "/api/cron/qa-transcriptions",
      "schedule": "*/5 6-19 * * 1-5"
    },
    {
      "path": "/api/cron/qa-transcriptions",
      "schedule": "0 0-5,20-23 * * 1-5"
    },
    {
      "path": "/api/cron/qa-transcriptions",
      "schedule": "0 * * * 0,6"
    }
  ]
}
