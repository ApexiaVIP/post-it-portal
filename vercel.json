{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 2,10,11,16,17,19,20 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "30 11,12,14,15 * * 1-5"
    },
    {
      "path": "/api/cron/qa-sync",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/qa-process",
      "schedule": "*/10 1-4 * * *"
    },
    {
      "path": "/api/cron/qa-digest",
      "schedule": "15 6 * * 1-6"
    }
  ]
}
